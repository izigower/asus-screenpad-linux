#!/bin/bash
# Allume ou éteint le panneau du ScreenPad d'un ASUS ZenBook.
#
# Le firmware laisse le panneau éteint au démarrage. Tant qu'il l'est, le
# connecteur reste "disconnected" côté DRM : aucun système ne voit l'écran, et
# rien ne le distingue d'un port vide. Le pilote asus-wmi connaît pourtant le
# device WMI qui l'allume, mais n'expose pas d'écriture fiable dessus — son
# attribut bl_power ne reflète même pas l'état réel du panneau.
#
# On passe donc par acpi_call pour invoquer directement la méthode ACPI du
# firmware : \_SB.ATKD.WMNB, méthode DEVS, device id 0x00050031.
#
# La luminosité passe par le même chemin, device id 0x00050032 : le pilote
# asus-wmi de Linux <= 7.1 lit l'état d'alimentation à l'envers, et toute
# écriture dans /sys/class/backlight/asus_screenpad éteint le panneau.
#
# usage : screenpad-power {on|off|toggle|status|is-on|brightness [1-255]}

set -u

DEVICE_ID=0x00050031      # SCREENPAD_POWER
LUMIERE_ID=0x00050032     # SCREENPAD_LIGHT
DEVS=0x53564544           # "DEVS" : écriture
DSTS=0x53545344           # "DSTS" : lecture
METHODE='\_SB.ATKD.WMNB'

modprobe acpi_call 2>/dev/null
[[ -e /proc/acpi/call ]] || { echo "acpi_call indisponible (paquet acpi_call-dkms)" >&2; exit 1; }

# Construit le tampon attendu : id du device puis valeur, chacun sur 4 octets
# en little-endian.
tampon() {
  printf 'b%02x%02x%02x%02x%02x%02x%02x%02x' \
    $((  $1      & 0xff )) $(( ($1>>8)  & 0xff )) $(( ($1>>16) & 0xff )) $(( ($1>>24) & 0xff )) \
    $((  $2      & 0xff )) $(( ($2>>8)  & 0xff )) $(( ($2>>16) & 0xff )) $(( ($2>>24) & 0xff ))
}

appel() {
  echo "$METHODE 0x0 $1 $2" > /proc/acpi/call 2>/dev/null
  tr -d '\0' < /proc/acpi/call
}

etat() { appel $DSTS "$(tampon $((DEVICE_ID)) 0)"; }
allume() { (( ( $(( $(etat) )) & 0xffff ) != 0 )); }

case "${1:-status}" in
  on)     appel $DEVS "$(tampon $((DEVICE_ID)) 1)" >/dev/null; sleep 1; echo "$(etat)" ;;
  off)    appel $DEVS "$(tampon $((DEVICE_ID)) 0)" >/dev/null; sleep 1; echo "$(etat)" ;;
  toggle) allume && exec "$0" off || exec "$0" on ;;
  status) etat ;;
  is-on)  allume ;;
  brightness)
    # Sans valeur : lire. Octet de poids faible = luminosité, 0xff = maximum.
    if [[ -z ${2:-} ]]; then
      echo $(( $(appel $DSTS "$(tampon $((LUMIERE_ID)) 0)") & 0xff ))
      exit
    fi
    # 0 est refusé : sur un pad éteint, le firmware rallume le panneau à
    # toute valeur non nulle, et 0 ne sert à rien d'autre que noircir.
    [[ $2 =~ ^[0-9]+$ ]] && (( $2 >= 1 && $2 <= 255 )) \
      || { echo "luminosité : entier de 1 à 255" >&2; exit 1; }
    appel $DEVS "$(tampon $((LUMIERE_ID)) $2)" >/dev/null ;;
  *)      echo "usage: $(basename "$0") {on|off|toggle|status|is-on|brightness [1-255]}" >&2; exit 1 ;;
esac
