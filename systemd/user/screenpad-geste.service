[Unit]
Description=Clic a 3 doigts sur le ScreenPad en mode souris : retour au dock tactile
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/screenpad/screenpad-geste.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
